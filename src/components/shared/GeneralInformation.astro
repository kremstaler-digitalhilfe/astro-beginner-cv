---
/**
 * General Information — label + value from cv-raw-data.json
 * Edit the generalInformation array with your real details.
 *
 * Layout: Card → stack (h4 title + list). Lives under Key facts.
 */
import Card from './Card.astro';
import type { GeneralInformationProps as Props } from '../../types/cv';

const { items } = Astro.props;
---

<div class="general-information" id="general-information">
	<Card>
		<div class="skills-body">
			<h4 class="card-title">General Information</h4>
			<ul class="skills-list general-information-list">
				{
					items.map((item) => (
						<li>
							<strong>{item.label}</strong>
							{' — '}
							{item.value}
						</li>
					))
				}
			</ul>
		</div>
	</Card>
</div>

<style>
	.general-information :global(.card) {
		width: 100%;
		height: 100%;
	}

	/* Stack: title + list */
	.skills-body {
		display: flex;
		flex-direction: column;
		gap: var(--space);
		width: 100%;
	}

	.card-title {
		font-size: 1.15rem;
		margin: 0;
	}

	.skills-list {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		margin: 0;
		padding-left: 1.25rem;
	}
</style>
