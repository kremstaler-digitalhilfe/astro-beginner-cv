---
/**
 * Education — list from cv-raw-data.json
 * Replace the demo entries with your real education.
 *
 * Layout: section stack → list stack → each item stack (flex + gap).
 */
import type { EducationProps as Props } from '../../types/cv';

const { items } = Astro.props;
---

<section class="cv-section education" id="education">
	<h3 class="section-title">Education</h3>
	<ul class="education-list">
		{
			items.map((entry) => (
				<li class="education-item">
					<h4 class="education-degree">
						{entry.degree} · {entry.school}
					</h4>
					<p class="education-meta">
						{entry.start} – {entry.end}
					</p>
					<p>{entry.description}</p>
				</li>
			))
		}
	</ul>
</section>

<style>
	/* Section stack: title + list */
	.education {
		display: flex;
		flex-direction: column;
		gap: var(--space);
	}

	.education-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space);
	}

	/* Item stack: degree, dates, description */
	.education-item {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.education-degree {
		font-size: 1.15rem; /* h4 — a bit smaller than h3 section titles */
		margin: 0;
	}

	.education-meta {
		font-family: var(--font-hand);
		font-size: 1.1rem;
		color: var(--purple);
		margin: 0;
	}

	.education-item p {
		margin: 0;
	}
</style>
